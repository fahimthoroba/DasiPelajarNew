# =============================================================================
# DASI Pelajar — Environment Configuration
# Copy file ini ke .env lalu isi nilai yang diperlukan.
# JANGAN pernah commit file .env ke git.
# =============================================================================

APP_NAME="DASI Pelajar"
APP_ENV=local                   # PRODUCTION: ganti ke 'production'
APP_KEY=                        # Generate: php artisan key:generate
APP_DEBUG=true                  # PRODUCTION: ganti ke 'false' — WAJIB
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost         # PRODUCTION: ganti ke domain Cloudflare

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                 # PRODUCTION: ganti ke 'error'

# -----------------------------------------------------------------------------
# DATABASE — MariaDB (via Docker)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dasi_pelajar
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# SESSION & CACHE
# Catatan: SESSION_DOMAIN harus KOSONG (bukan kata 'null') — jika diisi 'null'
# akan menyebabkan error 419 Page Expired pada semua form.
# -----------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local           # PRODUCTION: ganti ke 's3' setelah MinIO aktif
QUEUE_CONNECTION=database

CACHE_STORE=file                # PRODUCTION: ganti ke 'redis' setelah Redis aktif
CACHE_PREFIX=dasi_

# -----------------------------------------------------------------------------
# REDIS (aktifkan setelah Docker Redis setup)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MINIO — Object Storage (S3-compatible)
# Endpoint: http://minio:9000 (dalam Docker), http://localhost:9000 (di luar)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dasi-public
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# -----------------------------------------------------------------------------
# MAIL
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dasipelajar.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
